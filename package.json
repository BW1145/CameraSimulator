{
  "name": "camera-simulator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "vite --host 127.0.0.1 --port 8000",
    "build": "vite build --base=./ && node tools/copy-legacy.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 8000",
    "test": "node --test tests/camera.test.mjs tests/temporal-exposure.test.mjs tests/detail-region.test.mjs tests/detail-pass.test.mjs tests/subject-lighting.test.mjs tests/view-encoding.test.mjs",
    "audit:assets": "node tools/audit-assets.mjs",
    "test:browser": "playwright test",
    "pretest:browser": "npm run build"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "^1.56.0",
    "meshoptimizer": "^1.3.0",
    "sharp": "^0.35.5",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "three": "^0.186.1"
  }
}
